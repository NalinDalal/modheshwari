# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
DOTENV_CONFIG_QUIET=true

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD:-changeme}@redis:6379
REDIS_PASSWORD=changeme

# Notification Worker
CONSUMER_TYPE=all  # all | router | email | push | sms

# Kafka
KAFKA_BROKER=kafka:9092
KAFKAJS_NO_PARTITIONER_WARNING=1

# Notification Providers
EMAIL_PROVIDER=console  # smtp | sendgrid | ses | console
PUSH_PROVIDER=console   # fcm | apns | console
SMS_PROVIDER=console    # twilio | aws-sns | console

# WebSocket
WS_PORT=3002

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Logging
LOG_LEVEL=INFO
LOG_PRETTY=true

# Notification Cache
NOTIFICATION_CACHE=true
NOTIFICATION_CACHE_TTL_SECONDS=604800

# Elasticsearch
elastic_api_key=your_elasticsearch_api_key_here
elastic_node=https://your-elasticsearch-endpoint:443
